# Server
NODE_ENV=production
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com

# Scrape auth key – set a strong random string
SCRAPE_API_KEY=change_me_to_a_strong_secret

# Scraper timeouts (seconds)
API_TIMEOUT=15

# NYT Cooking (optional – needed for paywalled recipes)
NYT_SESSION_COOKIE=NYT-S=your_cookie_value
