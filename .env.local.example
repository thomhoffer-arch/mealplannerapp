# ─── Supabase (get from https://app.supabase.com → project → Settings → API) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase service role (server-side only — never expose to frontend) ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Spoonacular (get from https://spoonacular.com/food-api) ──────────────────
SPOONACULAR_API_KEY=your-spoonacular-key

# ─── HelloFresh unofficial API (optional — community credentials, may change) ──
# CLIENT_ID falls back to 'hellofresh-dev-test' in code if unset; CLIENT_SECRET
# has no code fallback and the scraper no-ops without it — never commit a real
# value here. Source the current community secret from the team's password
# manager / private notes, not from this file.
HELLOFRESH_CLIENT_ID=hellofresh-dev-test
HELLOFRESH_CLIENT_SECRET=your-hellofresh-client-secret

# ─── Google Gemini (get from https://aistudio.google.com/app/apikey) ────────────
GEMINI_API_KEY=your-gemini-key
# Optional — comma-separated Gemini model fallback chain. On 429 (quota) or
# 503 (upstream), calls fall through to the next model. Default if unset:
#   gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro

# ─── Pexels (get from https://www.pexels.com/api/) ─────────────────────────────
# Optional — when set, week-plan and per-day-regenerate responses include a
# hero photo URL per recipe. Free tier: 200 req/hour, 20k/month.
PEXELS_API_KEY=your-pexels-key

# ─── Vercel cron auth (set this in Vercel dashboard, Vercel sets it automatically)
CRON_SECRET=auto-set-by-vercel

# ─── AI usage cap bypass (TEMPORARY — remove when tiers are back in play) ──────
# Set to 1 on Vercel to bypass the 15/week free-tier cap for every household.
# Useful while is_gifted is unreachable in the Supabase console, or during
# demos. Unset it to re-enable the cap.
# DISABLE_AI_LIMIT=1
